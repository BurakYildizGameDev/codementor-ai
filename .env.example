# DİKKAT: Bu dosya OTOMATİK YÜKLENMEZ (Faz C, O8). Değerleri ortam değişkeni olarak ayarlayın:
#   PowerShell:  $env:ANTHROPIC_API_KEY = "sk-ant-..."
#   bash/zsh:    export ANTHROPIC_API_KEY=sk-ant-...
# Neden: çalışma dizinindeki bir .env öğrenci projesinden gelebilir ve sağlayıcı komutunu
# değiştirebilirdi (mimari §12). Masaüstünde anahtarlar Bağlantılar ekranından girilir
# (Windows Kimlik Bilgisi Yöneticisi'nde saklanır, dosyaya yazılmaz).

# Sağlayıcı anahtarları (adları codementor.toml'daki api_key_env ile aynı)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# REST API'yi korumak için (tanımlıysa istekler X-API-Key başlığı ister)
CODEMENTOR_API_KEY=

# Ortam değişkenleri codementor.toml değerlerini ezer. İç içe alanlar için ayraç: __
# CODEMENTOR_PROVIDERS__DEFAULT=claude_cli
# CODEMENTOR_LIMITS__MAX_LINES=600
# CODEMENTOR_CONFIG_FILE=C:/yol/codementor.toml
