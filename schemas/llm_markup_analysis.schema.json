{
  "$defs": {
    "AuditCategory": {
      "enum": [
        "memory_safety",
        "resource_leak",
        "undefined_behavior",
        "garbage_collection",
        "performance",
        "engine_best_practice",
        "edge_case",
        "input_handling",
        "design",
        "accessibility",
        "maintainability"
      ],
      "title": "AuditCategory",
      "type": "string"
    },
    "LLMFinding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/AuditCategory"
        },
        "certainty": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certainty"
        },
        "description": {
          "maxLength": 400,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "description": "Satırdan birebir alıntı",
          "maxLength": 200,
          "title": "Evidence",
          "type": "string"
        },
        "kind": {
          "default": "issue",
          "enum": [
            "issue",
            "suggestion"
          ],
          "title": "Kind",
          "type": "string"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "category",
        "severity",
        "line_start",
        "evidence",
        "description"
      ],
      "title": "LLMFinding",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "llm_markup_analysis.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "additional_findings": {
      "items": {
        "$ref": "#/$defs/LLMFinding"
      },
      "maxItems": 10,
      "title": "Additional Findings",
      "type": "array"
    }
  },
  "required": [
    "additional_findings"
  ],
  "title": "LLMMarkupAnalysisOutput",
  "type": "object"
}
