<Project Sdk="Microsoft.NET.Sdk">
  <!-- CodeMentor AI Tier 1 C#/Unity sözdizimi aracı (mimari §5.2.2, ADR-0009).
       Derleme: make roslyn-check  →  tools/roslyn-check/out/RoslynCheck.dll -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>RoslynCheck</AssemblyName>
    <RootNamespace>CodeMentor.RoslynCheck</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
</Project>
